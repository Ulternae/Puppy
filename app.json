{
  "expo": {
    "name": "PuppyMobile",
    "slug": "PuppyMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/puppy-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3C2F33",
        "foregroundImage": "./assets/brand/puppy-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand/puppy-icon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-router",
      "expo-mail-composer",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3C2F33",
          "image": "./assets/brand/puppy-foreground.png",
          "imageWidth": 200
        }
      ]
    ],
    "scheme": "puppymobile",
    "experiments": {
      "typedRoutes": true
    }
  }
}
